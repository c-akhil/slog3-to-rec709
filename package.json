{
  "name": "slog709",
  "version": "1.0.0",
  "description": "Batch-convert Sony A7S III S-Log3 footage to Rec.709 using FFmpeg",
  "type": "module",
  "bin": {
    "slog709": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ffmpeg",
    "s-log3",
    "rec709",
    "sony",
    "a7siii",
    "video",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "p-limit": "^6.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
